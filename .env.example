# ShikshaSetu Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR SERVICE ROLE KEYS TO VERSION CONTROL

# Server Port
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=development

# JSON Web Token Secret (Provide a strong 256-bit secret in production)
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars

# Token Expiry Duration
JWT_EXPIRES_IN=24h

# Database Path (Local SQLite file used in development/offline testing)
DB_PATH=shikshasetu.db

# Authentication Rate Limiting & Escalating Lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Supabase Production Configuration (Optional when deploying with PostgreSQL)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-client-anon-key
